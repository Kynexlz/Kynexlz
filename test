local Commands = {}
 
Commands["speed"] = function(args)
	local value = clamp(args[1], 1, 1000)
	if not value then return end
	local _, hum = getCharacter()
	if hum then
		hum.WalkSpeed = value
	end
end
 
Commands["jumppower"] = function(args)
	local value = clamp(args[1], 1, 1000)
	if not value then return end
	local _, hum = getCharacter()
	if hum then
		hum.UseJumpPower = true
		hum.JumpPower = value
	end
end
 
Commands["fly"] = function(args)
	-- args[1] is "mobile" or "pc" -- movement uses WASD either way here,
	-- kept as an accepted argument for compatibility with the requested syntax
	startFly()
end
 
Commands["unfly"] = function(args)
	stopFly()
end
 
Commands["noclip"] = function(args)
	startNoclip()
end
 
Commands["clip"] = function(args)
	stopNoclip()
end
 
Commands["teleport"] = function(args)
	-- usage: teleport to <player>
	local targetName = args[1] == "to" and args[2] or args[1]
	if not targetName then return end
	local target = findPlayerByName(targetName)
	if not target then return end
 
	local _, _, myHrp = getCharacter()
	local targetChar = target.Character
	local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if myHrp and targetHrp then
		myHrp.CFrame = targetHrp.CFrame + Vector3.new(0, 3, 0)
	end
end
 
Commands["fling"] = function(args)
	local targetName = args[1]
	if not targetName then return end
	local target = findPlayerByName(targetName)
	if not target then return end
 
	local targetChar = target.Character
	local targetHrp = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	if not targetHrp then return end
 
	local bv = Instance.new("BodyVelocity")
	bv.Name = "AdminFlingForce"
	bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	bv.Velocity = randomFlingVelocity()
	bv.Parent = targetHrp
	Debris:AddItem(bv, 0.6)
end
 
Commands["unfling"] = function(args)
	local targetName = args[1]
	local target = targetName and findPlayerByName(targetName)
	if not target then return end
 
	stopLoopFling(target)
	local char = target.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local bv = hrp:FindFirstChild("AdminFlingForce")
		if bv then bv:Destroy() end
	end
end
 
Commands["loopfling"] = function(args)
	local targetName = args[1]
	local target = targetName and findPlayerByName(targetName)
	if not target then return end
 
	stopLoopFling(target)
	local conn = RunService.Heartbeat:Connect(function()
		local char = target.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end
 
		local bv = hrp:FindFirstChild("AdminLoopFling")
		if not bv then
			bv = Instance.new("BodyVelocity")
			bv.Name = "AdminLoopFling"
			bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
			bv.Parent = hrp
		end
		bv.Velocity = randomFlingVelocity()
	end)
	loopFlingConns[target] = conn
end
 
