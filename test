----------------------------------------------------------------
-- FREECAM STATE
----------------------------------------------------------------
 
local freecamOn = false
local freecamConn, freecamInputConn
local freecamYaw, freecamPitch = 0, 0
local freecamPos = Vector3.new()
local savedCamType, savedCamSubject, savedMouseBehavior
 
local function stopFreecam()
	if not freecamOn then return end
	freecamOn = false
	if freecamConn then freecamConn:Disconnect() freecamConn = nil end
	if freecamInputConn then freecamInputConn:Disconnect() freecamInputConn = nil end
	local camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = savedCamType or Enum.CameraType.Custom
		if savedCamSubject then camera.CameraSubject = savedCamSubject end
	end
	UserInputService.MouseBehavior = savedMouseBehavior or Enum.MouseBehavior.Default
end
 
local function startFreecam()
	local camera = workspace.CurrentCamera
	if not camera then return end
	stopFreecam()
	freecamOn = true
 
	savedCamType = camera.CameraType
	savedCamSubject = camera.CameraSubject
	savedMouseBehavior = UserInputService.MouseBehavior
 
	local startCFrame = camera.CFrame
	freecamPos = startCFrame.Position
	local rx, ry = startCFrame:ToOrientation()
	freecamYaw = math.deg(ry)
	freecamPitch = math.deg(rx)
 
	camera.CameraType = Enum.CameraType.Scriptable
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
 
	freecamInputConn = UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			freecamYaw = freecamYaw - input.Delta.X * 0.35
			freecamPitch = math.clamp(freecamPitch - input.Delta.Y * 0.35, -85, 85)
		end
	end)
 
	freecamConn = RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera
		if not cam then return end
 
		local rotCFrame = CFrame.Angles(0, math.rad(freecamYaw), 0) * CFrame.Angles(math.rad(freecamPitch), 0, 0)
		local moveVector = Vector3.new(0, 0, 0)
		local look = rotCFrame.LookVector
		local right = rotCFrame.RightVector
 
		if flyKeysDown[Enum.KeyCode.W] then moveVector += look end
		if flyKeysDown[Enum.KeyCode.S] then moveVector -= look end
		if flyKeysDown[Enum.KeyCode.A] then moveVector -= right end
		if flyKeysDown[Enum.KeyCode.D] then moveVector += right end
		if flyKeysDown[Enum.KeyCode.Space] then moveVector += Vector3.new(0, 1, 0) end
		if flyKeysDown[Enum.KeyCode.LeftShift] then moveVector -= Vector3.new(0, 1, 0) end
 
		if moveVector.Magnitude > 0 then
			moveVector = moveVector.Unit
		end
 
		freecamPos = freecamPos + moveVector * 80 * dt
		cam.CFrame = CFrame.new(freecamPos) * rotCFrame
	end)
end
 
----------------------------------------------------------------
-- FREEZE STATE (per target player)
----------------------------------------------------------------
 
local frozenTargets = {} -- [Player] = { [BasePart] = originalAnchored }
 
local function resolveTarget(name)
	if name and name ~= "" then
		return findPlayerByName(name)
	end
	return LocalPlayer
end
 
local function setFrozen(player, state)
	local char = player.Character
	if not char then return end
 
	if state then
		frozenTargets[player] = frozenTargets[player] or {}
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				if frozenTargets[player][part] == nil then
					frozenTargets[player][part] = part.Anchored
				end
				part.Anchored = true
			end
		end
	else
		local saved = frozenTargets[player]
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Anchored = (saved and saved[part]) or false
			end
		end
		frozenTargets[player] = nil
	end
end
 
