local loopFlingConns = {} -- [Player] = RBXScriptConnection
 
local function randomFlingVelocity()
	return Vector3.new(
		math.random(-300, 300),
		math.random(200, 400),
		math.random(-300, 300)
	)
end
 
local function stopLoopFling(player)
	local conn = loopFlingConns[player]
	if conn then
		conn:Disconnect()
		loopFlingConns[player] = nil
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local bv = hrp:FindFirstChild("AdminLoopFling")
		if bv then bv:Destroy() end
	end
end
 
----------------------------------------------------------------
-- FOLLOW STATE
----------------------------------------------------------------
 
local followTarget = nil
local followConn = nil
 
local function stopFollow()
	followTarget = nil
	if followConn then
		followConn:Disconnect()
		followConn = nil
	end
end
 
local function startFollow(target)
	stopFollow()
	followTarget = target
	followConn = RunService.Heartbeat:Connect(function()
		if not followTarget or not followTarget.Parent then
			stopFollow()
			return
		end
		local _, hum, hrp = getCharacter()
		local tChar = followTarget.Character
		local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
		if not hrp or not tHrp then return end
 
		local t = tick()
		local offset = Vector3.new(math.sin(t * 4) * 6, math.sin(t * 6) * 2 + 3, math.cos(t * 4) * 6)
		hrp.CFrame = CFrame.new(tHrp.Position + offset, tHrp.Position)
 
		-- purely cosmetic flash/sound burst (no blast damage or knockback force)
		if math.random() < 0.15 then
			local explosion = Instance.new("Explosion")
			explosion.Position = hrp.Position
			explosion.BlastRadius = 0
			explosion.BlastPressure = 0
			explosion.Parent = workspace
		end
	end)
end
 
