----------------------------------------------------------------
-- COMMAND DISPATCH (shared by chat + panel)
----------------------------------------------------------------
 
local function sendCommand(fullText)
	fullText = fullText:gsub("^%s+", ""):gsub("%s+$", "")
	if fullText == "" then return end
 
	if fullText:sub(1, 1) == PREFIX then
		fullText = fullText:sub(2)
	end
 
	local parts = splitArgs(fullText)
	if #parts == 0 then return end
 
	local commandName = table.remove(parts, 1):lower()
 
	local fn = Commands[commandName]
	if fn then
		fn(parts)
	end
end
 
----------------------------------------------------------------
-- BUILD COMMAND LIST ROWS
----------------------------------------------------------------
 
local function clearList()
	for _, child in ipairs(listFrame:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
end
 
local function populateList(filter)
	clearList()
	filter = (filter or ""):lower()
 
	local order = 0
	for _, cmd in ipairs(COMMANDS) do
		if filter == "" or cmd.name:find(filter, 1, true) or cmd.usage:lower():find(filter, 1, true) then
			order += 1
 
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, 0, 0, 46)
			row.BackgroundColor3 = COLOR_ROW
			row.LayoutOrder = order
			row.ZIndex = 10
			row.Parent = listFrame
 
			local rowCorner = Instance.new("UICorner")
			rowCorner.CornerRadius = UDim.new(0, 8)
			rowCorner.Parent = row
 
			local rowBtn = Instance.new("TextButton")
			rowBtn.Size = UDim2.new(1, 0, 1, 0)
			rowBtn.BackgroundTransparency = 1
			rowBtn.Text = ""
			rowBtn.ZIndex = 11
			rowBtn.Parent = row
 
			local nameLabel = Instance.new("TextLabel")
			nameLabel.Size = UDim2.new(1, -16, 0, 18)
			nameLabel.Position = UDim2.new(0, 10, 0, 5)
			nameLabel.BackgroundTransparency = 1
			nameLabel.Text = cmd.usage
			nameLabel.Font = FONT_BOLD
			nameLabel.TextSize = 13
			nameLabel.TextColor3 = COLOR_WHITE
			nameLabel.TextXAlignment = Enum.TextXAlignment.Left
			nameLabel.ZIndex = 11
			nameLabel.Parent = row
 
			local descLabel = Instance.new("TextLabel")
			descLabel.Size = UDim2.new(1, -16, 0, 16)
			descLabel.Position = UDim2.new(0, 10, 0, 23)
			descLabel.BackgroundTransparency = 1
			descLabel.Text = cmd.desc
			descLabel.Font = FONT
			descLabel.TextSize = 11
			descLabel.TextColor3 = COLOR_GRAY
			descLabel.TextXAlignment = Enum.TextXAlignment.Left
			descLabel.ZIndex = 11
			descLabel.Parent = row
 
			rowBtn.MouseEnter:Connect(function()
				row.BackgroundColor3 = COLOR_ROW_HOVER
			end)
			rowBtn.MouseLeave:Connect(function()
				row.BackgroundColor3 = COLOR_ROW
			end)
			rowBtn.MouseButton1Click:Connect(function()
				if cmd.name == "prefix" then
					sendCommand("prefix")
					return
				end
				inputBox.Text = PREFIX .. cmd.name .. " "
				inputBox:CaptureFocus()
			end)
		end
	end
end
 
populateList("")
 
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
	populateList(searchBox.Text)
end)
 
