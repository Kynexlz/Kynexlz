local function startFloat()
	local _, _, hrp = getCharacter()
	if not hrp then return end
	stopFloat()
 
	local bf = Instance.new("BodyForce")
	bf.Name = "AdminFloat"
	bf.Force = Vector3.new(0, workspace.Gravity * hrp.AssemblyMass, 0)
	bf.Parent = hrp
 
	floatConn = RunService.Heartbeat:Connect(function()
		local _, _, curHrp = getCharacter()
		if not curHrp then
			stopFloat()
			return
		end
		local force = curHrp:FindFirstChild("AdminFloat")
		if force then
			force.Force = Vector3.new(0, workspace.Gravity * curHrp.AssemblyMass, 0)
		end
	end)
end
 
