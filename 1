local p=game.Players.LocalPlayer
local rs=game:GetService("RunService")
local cam=workspace.CurrentCamera
local orbit,a=false,0

p.Chatted:Connect(function(m)
    m=m:lower()
    if m=="!orbitcam" then
        if orbit then return end
        orbit=true
        rs:BindToRenderStep("OrbitCam",Enum.RenderPriority.Camera.Value+1,function(dt)
            local hrp=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                a+=dt
                local pos=hrp.Position+Vector3.new(math.cos(a)*10,4,math.sin(a)*10)
                cam.CameraType=Enum.CameraType.Scriptable
                cam.CFrame=CFrame.new(pos,hrp.Position)
            end
        end)
    elseif m=="!unoc" then
        orbit=false
        rs:UnbindFromRenderStep("OrbitCam")
        cam.CameraType=Enum.CameraType.Custom
        local h=p.Character and p.Character:FindFirstChildOfClass("Humanoid")
        if h then
            cam.CameraSubject=h
        end
    end
end)
