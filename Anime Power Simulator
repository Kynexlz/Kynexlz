local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Kynexlz/KynLife/refs/heads/main/Source"))()

local Window = Library:CreateWindow("APS Hub")

local MainPage = Window:addPage("Main", 4, true, 6)
local SettingsPage = Window:addPage("Utility", 4, false, 6)

MainPage:addLabel("Auto Grind")

local mode = nil
local mobilityEnabled = false -- new toggle state

MainPage:addToggle("Strength", function(state)
    mode = state and 1 or nil
end)

MainPage:addToggle("Health", function(state)
    mode = state and 2 or nil
end)

MainPage:addToggle("Psychics", function(state)
    mode = state and 3 or nil
end)

MainPage:addToggle("Magic", function(state)
    mode = state and 6 or nil
end)

MainPage:addToggle("Meele", function(state)
    mode = state and 7 or nil
end)

MainPage:addToggle("Aura", function(state)
    mode = state and 8 or nil
end)

-- NEW TOGGLE
MainPage:addToggle("Mobility", function(state)
    mobilityEnabled = state
end)

task.spawn(function()
    while true do
        if mode then
            game:GetService("ReplicatedStorage")
                :WaitForChild("Events")
                :WaitForChild("TrainSignal")
                :FireServer(mode)
        end

        if mobilityEnabled then
            game:GetService("ReplicatedStorage")
                :WaitForChild("Events")
                :WaitForChild("TriggerMobility")
                :FireServer()
        end

        task.wait()
    end
end)
