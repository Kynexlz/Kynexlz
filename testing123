----------------------------------------------------------------
-- ANTI-LAG (reduces particle/lighting effects to help performance)
----------------------------------------------------------------
 
local antiLagActive = false
local antiLagDisabledEmitters = {}
local antiLagOriginalLightingProps = {}
local antiLagDisabledEffects = {}
 
local function startAntiLag()
	if antiLagActive then return end
	antiLagActive = true
 
	for _, obj in ipairs(workspace:GetDescendants()) do
		if (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam")) and obj.Enabled then
			obj.Enabled = false
			table.insert(antiLagDisabledEmitters, obj)
		end
	end
 
	local Lighting = game:GetService("Lighting")
	antiLagOriginalLightingProps.GlobalShadows = Lighting.GlobalShadows
	Lighting.GlobalShadows = false
 
	for _, effect in ipairs(Lighting:GetChildren()) do
		if effect:IsA("PostEffect") and effect.Enabled then
			effect.Enabled = false
			table.insert(antiLagDisabledEffects, effect)
		end
	end
end
 
local function stopAntiLag()
	antiLagActive = false
	for _, obj in ipairs(antiLagDisabledEmitters) do
		if obj and obj.Parent then
			obj.Enabled = true
		end
	end
	antiLagDisabledEmitters = {}
 
	for _, effect in ipairs(antiLagDisabledEffects) do
		if effect and effect.Parent then
			effect.Enabled = true
		end
	end
	antiLagDisabledEffects = {}
 
	local Lighting = game:GetService("Lighting")
	if antiLagOriginalLightingProps.GlobalShadows ~= nil then
		Lighting.GlobalShadows = antiLagOriginalLightingProps.GlobalShadows
	end
end
 
