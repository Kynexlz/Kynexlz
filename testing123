local function stopRocketFly()
	rocketFlying = false
	rocketMobileUp = false
	rocketMobileDown = false
	if rocketFlyConn then
		rocketFlyConn:Disconnect()
		rocketFlyConn = nil
	end
	if rocketFlyButtonsGui then
		rocketFlyButtonsGui:Destroy()
		rocketFlyButtonsGui = nil
	end
	local _, hum, hrp = getCharacter()
	if hrp then
		local bv = hrp:FindFirstChild("RocketFlyForce")
		local bg = hrp:FindFirstChild("RocketFlyGyro")
		local att = hrp:FindFirstChild("RocketFlyAttachment")
		if bv then bv:Destroy() end
		if bg then bg:Destroy() end
		if att then att:Destroy() end
	end
	if hum then
		hum.PlatformStand = false
	end
end
 
local function startRocketFly(mode)
	local char, hum, hrp = getCharacter()
	if not hrp then return end
 
	stopFly()
	stopFloat()
	stopRocketFly()
	rocketFlying = true
 
	mode = mode or ((UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) and "mobile" or "pc")
 
	local bv = Instance.new("BodyVelocity")
	bv.Name = "RocketFlyForce"
	bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	bv.Velocity = Vector3.new(0, 0, 0)
	bv.Parent = hrp
 
	local bg = Instance.new("BodyGyro")
	bg.Name = "RocketFlyGyro"
	bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	bg.D = 50
	bg.CFrame = hrp.CFrame
	bg.Parent = hrp
 
	hum.PlatformStand = true
	makeRocketExhaust(hrp)
 
	if mode == "mobile" then
		rocketFlyButtonsGui = makeRocketMobileButtons()
	end
 
	local speed = 65
 
	rocketFlyConn = RunService.Heartbeat:Connect(function()
		if not rocketFlying then return end
		local _, curHum, curHrp = getCharacter()
		if not curHrp then
			stopRocketFly()
			return
		end
 
		local moveVector
		if mode == "mobile" then
			-- horizontal movement comes from the default touch thumbstick (Humanoid.MoveDirection),
			-- vertical comes from the on-screen up/down buttons
			moveVector = curHum.MoveDirection
			if rocketMobileUp then moveVector += Vector3.new(0, 1, 0) end
			if rocketMobileDown then moveVector -= Vector3.new(0, 1, 0) end
		else
			local camera = workspace.CurrentCamera
			moveVector = Vector3.new(0, 0, 0)
			if camera then
				local lookVector = camera.CFrame.LookVector
				local rightVector = camera.CFrame.RightVector
				if flyKeysDown[Enum.KeyCode.W] then moveVector += lookVector end
				if flyKeysDown[Enum.KeyCode.S] then moveVector -= lookVector end
				if flyKeysDown[Enum.KeyCode.A] then moveVector -= rightVector end
				if flyKeysDown[Enum.KeyCode.D] then moveVector += rightVector end
				if flyKeysDown[Enum.KeyCode.Space] then moveVector += Vector3.new(0, 1, 0) end
				if flyKeysDown[Enum.KeyCode.LeftShift] then moveVector -= Vector3.new(0, 1, 0) end
			end
		end
 
		if moveVector.Magnitude > 0 then
			moveVector = moveVector.Unit
		end
 
		local curBv = curHrp:FindFirstChild("RocketFlyForce")
		local curBg = curHrp:FindFirstChild("RocketFlyGyro")
		if curBv then
			curBv.Velocity = moveVector * speed
		end
		if curBg then
			-- tilt animation: nose points along travel direction, banks slightly with horizontal movement
			if moveVector.Magnitude > 0.05 then
				local flatMove = Vector3.new(moveVector.X, 0, moveVector.Z)
				local lookTarget = curHrp.Position + (flatMove.Magnitude > 0.05 and flatMove or Vector3.new(0, 0, -1))
				local tilt = math.clamp(moveVector.Y, -1, 1) * math.rad(25)
				curBg.CFrame = CFrame.new(curHrp.Position, lookTarget) * CFrame.Angles(-tilt, 0, 0)
			end
		end
	end)
end
 
