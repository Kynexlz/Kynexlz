local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Kynexlz/KynLife/refs/heads/main/Source"))()

local Window = Library:CreateWindow("Training Hub")

local MainPage = Window:addPage("Main", 4, true, 6)
local GamepassPage = Window:addPage("Gamepass", 4, false, 6)

MainPage:addLabel("Auto Training")
GamepassPage:addLabel("Gamepass Training")

-- STATES
local pushupsEnabled = false
local situpsEnabled = false
local blackbagsEnabled = false
local benchEnabled = false
local dumbbellEnabled = false

-- SPEEDS
local pushupsSpeed = 50
local situpsSpeed = 50
local blackbagsSpeed = 50
local benchSpeed = 50
local dumbbellSpeed = 50

local function getDelay(speed)
    return math.clamp(1 - (speed / 100), 0.01, 1)
end

------------------------------------------------
-- MAIN PAGE
------------------------------------------------

MainPage:addToggle("PushUps", function(state)
    pushupsEnabled = state
end)

MainPage:addTextBox("PushUps Speed (1-100)", "50", function(text)
    pushupsSpeed = tonumber(text) or 50
end)

MainPage:addToggle("SitUps", function(state)
    situpsEnabled = state
end)

MainPage:addTextBox("SitUps Speed (1-100)", "50", function(text)
    situpsSpeed = tonumber(text) or 50
end)

MainPage:addToggle("Black Bags", function(state)
    blackbagsEnabled = state
end)

MainPage:addTextBox("Black Bags Speed (1-100)", "50", function(text)
    blackbagsSpeed = tonumber(text) or 50
end)

------------------------------------------------
-- GAMEPASS PAGE
------------------------------------------------

GamepassPage:addToggle("BenchPress", function(state)
    benchEnabled = state
end)

GamepassPage:addTextBox("Bench Speed (1-100)", "50", function(text)
    benchSpeed = tonumber(text) or 50
end)

GamepassPage:addToggle("Dumbbell", function(state)
    dumbbellEnabled = state
end)

GamepassPage:addTextBox("Dumbbell Speed (1-100)", "50", function(text)
    dumbbellSpeed = tonumber(text) or 50
end)

------------------------------------------------
-- LOOP
------------------------------------------------

task.spawn(function()
    while true do

        if pushupsEnabled then
            game:GetService("ReplicatedStorage").Remotes.PushUp:FireServer("{}")
            task.wait(getDelay(pushupsSpeed))
        end

        if situpsEnabled then
            game:GetService("ReplicatedStorage").Remotes.SitUp:FireServer("{}")
            task.wait(getDelay(situpsSpeed))
        end

        if blackbagsEnabled then
            game:GetService("ReplicatedStorage").Remotes.DoubleReg:FireServer("{}")
            task.wait(getDelay(blackbagsSpeed))
        end

        if benchEnabled then
            game:GetService("ReplicatedStorage").Remotes.Bench:FireServer("{}")
            task.wait(getDelay(benchSpeed))
        end

        if dumbbellEnabled then
            game:GetService("ReplicatedStorage").Remotes.Dumbell:FireServer("{}")
            task.wait(getDelay(dumbbellSpeed))
        end

        task.wait(0.05)
    end
end)
